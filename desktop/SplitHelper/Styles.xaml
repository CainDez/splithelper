<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SplitHelper">
  <SolidColorBrush x:Key="BackgroundBrush" Color="#101E28"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#162B36"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#38515D"/>
  <SolidColorBrush x:Key="TextBrush" Color="#EAF4F6"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#A1BAC5"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#7BDCC5"/>
  <local:EqualVisibilityConverter x:Key="EqualVisibility"/>
  <local:BooleanVisibilityConverter x:Key="BooleanVisibility"/>
  <local:ToneBrushConverter x:Key="ToneBrush"/>
  <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource BackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="23"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="22"/></Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="#172F3B"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#50717E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20,11"/><Setter Property="MinHeight" Value="43"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#7BDCC5"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="#102D33"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="18"/><Setter Property="Padding" Value="28,10"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1C25"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#4C6570"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="44"/><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/><Setter Property="SelectionBrush" Value="#357C80"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0D1C25"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#4C6570"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="44"/><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Margin" Value="0,18,0,0"/></Style>
  <DataTemplate x:Key="CheckTemplate"><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="10" Height="10" Fill="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" LineHeight="24"/></Grid></Border></DataTemplate>
  <Style x:Key="RouteNode" TargetType="Border"><Setter Property="Background" Value="#172D38"/><Setter Property="BorderBrush" Value="#56717E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="8"/></Style>
  <Style x:Key="OverviewNav" TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="overview"><Setter Property="Background" Value="#1B4958"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="SettingsNav" TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="settings"><Setter Property="Background" Value="#1B4958"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="DiagnosticsNav" TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="diagnostics"><Setter Property="Background" Value="#1B4958"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ConnectionTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding SettingsTab}" Value="0"><Setter Property="Background" Value="#28515E"/><Setter Property="BorderBrush" Value="#7BDCC5"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="StartupTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding SettingsTab}" Value="1"><Setter Property="Background" Value="#28515E"/><Setter Property="BorderBrush" Value="#7BDCC5"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="RulesTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding SettingsTab}" Value="2"><Setter Property="Background" Value="#28515E"/><Setter Property="BorderBrush" Value="#7BDCC5"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="RuleDomesticChoice" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding RuleTarget}" Value="ChinaDirect"><Setter Property="Background" Value="#28515E"/><Setter Property="BorderBrush" Value="#7BDCC5"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="RuleVpnChoice" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding RuleTarget}" Value="VPN"><Setter Property="Background" Value="#28515E"/><Setter Property="BorderBrush" Value="#7BDCC5"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="RuleRejectChoice" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding RuleTarget}" Value="REJECT"><Setter Property="Background" Value="#28515E"/><Setter Property="BorderBrush" Value="#7BDCC5"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="StepBase" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="MinHeight" Value="62"/><Setter Property="Padding" Value="14,12"/></Style>
  <Style x:Key="Step0" TargetType="Button" BasedOn="{StaticResource StepBase}"><Style.Triggers><DataTrigger Binding="{Binding WizardStep}" Value="0"><Setter Property="Background" Value="#1F414D"/><Setter Property="Foreground" Value="#7BDCC5"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="Step1" TargetType="Button" BasedOn="{StaticResource StepBase}"><Style.Triggers><DataTrigger Binding="{Binding WizardStep}" Value="1"><Setter Property="Background" Value="#1F414D"/><Setter Property="Foreground" Value="#7BDCC5"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="Step2" TargetType="Button" BasedOn="{StaticResource StepBase}"><Style.Triggers><DataTrigger Binding="{Binding WizardStep}" Value="2"><Setter Property="Background" Value="#1F414D"/><Setter Property="Foreground" Value="#7BDCC5"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="Step3" TargetType="Button" BasedOn="{StaticResource StepBase}"><Style.Triggers><DataTrigger Binding="{Binding WizardStep}" Value="3"><Setter Property="Background" Value="#1F414D"/><Setter Property="Foreground" Value="#7BDCC5"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="MullvadChoice" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Provider}" Value="Mullvad"><Setter Property="Background" Value="#1C4142"/><Setter Property="BorderBrush" Value="#7BDCC5"/><Setter Property="Foreground" Value="#7BDCC5"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="WindscribeChoice" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Provider}" Value="Windscribe"><Setter Property="Background" Value="#1C4142"/><Setter Property="BorderBrush" Value="#7BDCC5"/><Setter Property="Foreground" Value="#7BDCC5"/></DataTrigger></Style.Triggers></Style>
</ResourceDictionary>

